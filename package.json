{
  "name": "nordiclux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset.ts",
    "migrate:legacy-products": "tsx migration/legacy-nordic-lux/scripts/import.ts",
    "search:reindex": "tsx scripts/reindex.ts",
    "staff:create": "tsx scripts/create-staff.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "migrate:catalogue": "tsx --conditions=react-server migration/legacy-nordic-lux/scripts/catalogue-import.ts",
    "e2e:db": "tsx scripts/e2e-db.ts",
    "routine:rules": "tsx --conditions=react-server scripts/routine-rules.ts",
    "seed:sample-orders": "tsx --conditions=react-server scripts/seed-sample-orders.ts",
    "data:cleanup": "tsx --conditions=react-server scripts/cleanup-operating-data.ts",
    "media:normalize": "tsx scripts/normalize-product-media.ts",
    "media:brand-logos": "tsx --conditions=react-server scripts/fetch-brand-logos.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "next": "^16.3.1",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
