# =============================================================================
# Nordic Lux — environment configuration
#
# Production configuration template. Replace every <...> placeholder before use.
# Keep real credentials in the deployment secret store; never commit them.
# Every variable below is validated at startup by src/lib/env.ts.
# =============================================================================

NODE_ENV=production

# --- application -------------------------------------------------------------
APP_URL=https://your-store-domain.example
APP_NAME=Nordic Lux

# --- database (PostgreSQL) ---------------------------------------------------
# Replace the password placeholder and store the completed URL as a deployment secret.
DATABASE_URL="postgresql://<DB_USER>:<PRODUCTION_DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require"
DATABASE_POOL_MAX=10

# --- security ----------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every active session.
SESSION_SECRET=<GENERATE_A_NEW_RANDOM_VALUE>
SESSION_TTL_HOURS=720
STAFF_SESSION_TTL_HOURS=12

# --- cache / rate limiting (Valkey, Redis-compatible) ------------------------
# Use a production-reachable Redis-compatible service; this address assumes the
# app and Valkey run on the same host.
REDIS_URL=redis://localhost:6380

# --- search ------------------------------------------------------------------
# postgres = built-in full-text search, no extra service
# meilisearch = dedicated engine with typo tolerance
SEARCH_DRIVER=postgres
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# --- media storage -----------------------------------------------------------
# local = filesystem on a persistent volume, s3 = an S3-compatible provider
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=/media
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- mail --------------------------------------------------------------------
# SMTP relay for production transactional email.
MAIL_DRIVER=smtp
# Use a sender registered and verified with Brevo; a domain-authenticated
# sender is recommended for production delivery.
MAIL_FROM=Nordic Lux <thenordiclux@gmail.com>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<BREVO_SMTP_LOGIN>
SMTP_PASSWORD=<BREVO_SMTP_KEY_FROM_SECRET_STORE>
SMTP_SECURE=false

# --- social profiles ---------------------------------------------------------
# Optional overrides. The client-supplied profile URLs are the defaults in
# src/lib/social.ts. Never guess a handle: an unverified URL links customers
# to somebody else's account.
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_TIKTOK_URL=

# --- payments ----------------------------------------------------------------
# Production payments use PayHere; load both credentials from the secret store.
PAYMENT_DRIVER=payhere
PAYHERE_MERCHANT_ID=<PAYHERE_MERCHANT_ID>
PAYHERE_MERCHANT_SECRET=<PAYHERE_MERCHANT_SECRET_FROM_SECRET_STORE>
PAYHERE_SANDBOX=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- browser-visible configuration -------------------------------------------
# NEXT_PUBLIC_* values are inlined into the JavaScript bundle and are therefore
# PUBLIC. Never put a secret behind this prefix. Client components read these
# through src/lib/public-config.ts; src/lib/env.ts is server-only.
NEXT_PUBLIC_APP_NAME=Nordic Lux
NEXT_PUBLIC_APP_URL=https://your-store-domain.example
NEXT_PUBLIC_WHATSAPP_NUMBER=94770130299
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- integrations ------------------------------------------------------------
# WhatsApp number in international format, digits only.
WHATSAPP_NUMBER=94770130299
ANALYTICS_ENABLED=true
