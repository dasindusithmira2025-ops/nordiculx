# =============================================================================
# Nordic Lux — environment configuration
#
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit a real `.env`. See docs/DEPLOYMENT.md for production values.
# Every variable below is validated at startup by src/lib/env.ts.
# =============================================================================

NODE_ENV=development

# --- application -------------------------------------------------------------
APP_URL=http://localhost:3000
APP_NAME=Nordic Lux

# --- database (PostgreSQL) ---------------------------------------------------
# Matches the `postgres` service in docker-compose.yml.
DATABASE_URL=postgres://nordiclux:nordiclux_dev_password@localhost:5432/nordiclux
DATABASE_POOL_MAX=10

# --- security ----------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every active session.
SESSION_SECRET=dev_only_secret_replace_me_with_48_random_bytes_min
SESSION_TTL_HOURS=720
STAFF_SESSION_TTL_HOURS=12

# --- cache / rate limiting (Valkey, Redis-compatible) ------------------------
# Optional. Without it, rate limiting falls back to an in-process limiter that
# does not survive restarts or span multiple app instances.
REDIS_URL=redis://localhost:6380

# --- search ------------------------------------------------------------------
# postgres  = built-in full-text search, no extra service
# meilisearch = dedicated engine with typo tolerance
SEARCH_DRIVER=postgres
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=nordiclux_dev_master_key

# --- media storage -----------------------------------------------------------
# local = filesystem (development), s3 = any S3-compatible bucket (MinIO, R2, AWS)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=/media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nordiclux-media
S3_ACCESS_KEY_ID=nordiclux
S3_SECRET_ACCESS_KEY=nordiclux_dev_password
S3_FORCE_PATH_STYLE=true

# --- mail --------------------------------------------------------------------
# log  = writes rendered emails to the console/filesystem (development)
# smtp = real delivery. Mailpit (docker compose) gives you a local inbox on :8025
MAIL_DRIVER=log
MAIL_FROM=Nordic Lux <thenordiclux@gmail.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- payments ----------------------------------------------------------------
# mock = development-only simulation, payhere = legacy provider,
# stripe = Stripe-hosted Checkout. Use Stripe test keys during sandbox work.
PAYMENT_DRIVER=mock
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- browser-visible configuration -------------------------------------------
# NEXT_PUBLIC_* values are inlined into the JavaScript bundle and are therefore
# PUBLIC. Never put a secret behind this prefix. Client components read these
# through src/lib/public-config.ts; src/lib/env.ts is server-only.
NEXT_PUBLIC_APP_NAME=Nordic Lux
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=94776316512
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- integrations ------------------------------------------------------------
# WhatsApp number in international format, digits only.
WHATSAPP_NUMBER=94776316512
ANALYTICS_ENABLED=true
